<?php
/* ThemeEffects: 主题特效
 * 粒子 + 胡桃 + 背景 + 字体颜色 + 版本管理（检查更新 / 更新日志；安装完整覆盖）。
 * CSRF：完全交给 Unraid BodyInlineJS 注入（与 CustomCSS.page 一致），本页不写 csrf 字段。
 */
$fx_path = "/boot/config/plugins/theme.effects/theme-effects.cfg";
$ucwc_service_cfg = "/boot/config/plugins/theme.effects/theme.effects.cfg";
$ucwc_service = "enabled";
if (is_file($ucwc_service_cfg)) {
    $ucwc_svc_raw = @parse_ini_file($ucwc_service_cfg);
    if (is_array($ucwc_svc_raw) && isset($ucwc_svc_raw["SERVICE"]) && $ucwc_svc_raw["SERVICE"] !== "") {
        $ucwc_service = strtolower(trim((string)$ucwc_svc_raw["SERVICE"]));
    }
}
if (!in_array($ucwc_service, ["enabled", "enable", "1", "yes"], true)) {
    $ucwc_service = "disabled";
} else {
    $ucwc_service = "enabled";
}
$ucwc_service_on = ($ucwc_service === "enabled");

$assets_f = "/boot/config/plugins/theme.effects/assets";
$assets_r = "/usr/local/emhttp/plugins/theme.effects/assets";
$persist_dir = "/boot/config/plugins/theme.effects";
$log_path = "/tmp/ucwc-theme-fx-save.log";
$upd_log = "/tmp/ucwc-theme-update.log";
$repo_raw = "https://raw.githubusercontent.com/deltrivx/ThemeEffects/main";
$msg = "";
$force_reload = false;

/* Free PHP session lock ASAP so nginx auth-request can run while this page works.
 * Unraid Translations starts+closes session; re-close if anything reopened it. */
if (function_exists("session_status") && session_status() === PHP_SESSION_ACTIVE) {
    @session_write_close();
}

/* Ensure wallpaper PHP upload limits without touching /boot/config/go */
	(function () {
	    $src = "/boot/config/plugins/theme.effects/ucwc-upload.ini";
	    $dst = "/etc/php.d/ucwc-upload.ini";
	    if (!is_file($src)) {
	        @file_put_contents($src, "; ThemeEffects: wallpaper upload limits\nupload_max_filesize = 12M\npost_max_size = 16M\nmax_file_uploads = 20\n");
	        @chmod($src, 0644);
	    }
	    if (!is_file($src)) return;
	    $need = !is_file($dst);
	    if (!$need) {
	        $a = @file_get_contents($src);
	        $b = @file_get_contents($dst);
	        $need = ($a !== false && $a !== $b);
	    }
	    if ($need) {
	        @mkdir("/etc/php.d", 0755, true);
	        if (@copy($src, $dst)) @chmod($dst, 0644);
	    }
	})();

	/* nginx auth-request inherits CONTENT_LENGTH on large multipart POSTs → PHP-FPM
	 * waits for a body that never arrives → 504 → UI stuck on「应用中…」.
	 * Persist snippet on flash; re-inject into locations.conf after rc.nginx rebuild. */
	(function () {
	    $src = "/boot/config/plugins/theme.effects/ucwc-auth-request.conf";
	    $loc = "/etc/nginx/conf.d/locations.conf";
	    $marker = "ucwc-auth-fix";
	    $block =
	        "#\n" .
	        "# {$marker}: large multipart POST hangs because auth subrequest inherits CONTENT_LENGTH\n" .
	        "# and PHP-FPM waits for a body that never arrives → 504 → browser stuck on 应用中…\n" .
	        "#\n" .
	        "location = /auth-request.php {\n" .
	        "    internal;\n" .
	        "    include fastcgi_params;\n" .
	        "    fastcgi_param CONTENT_LENGTH \"\";\n" .
	        "    fastcgi_param REQUEST_METHOD GET;\n" .
	        "}\n";
	    $needSrc = !is_file($src);
	    if (!$needSrc) {
	        $cur = @file_get_contents($src);
	        $needSrc = ($cur === false || strpos($cur, "fastcgi_param CONTENT_LENGTH") === false);
	    }
	    if ($needSrc) {
	        @file_put_contents($src, $block);
	        @chmod($src, 0644);
	    }
	    if (!is_file($loc) || !is_writable($loc)) return;
	    $content = @file_get_contents($loc);
	    if ($content === false) return;
	    $has =
	        strpos($content, $marker) !== false &&
	        strpos($content, "location = /auth-request.php") !== false &&
	        strpos($content, "fastcgi_param CONTENT_LENGTH") !== false;
	    if ($has) return;
	    // Drop any partial prior inject before prepending
	    if (strpos($content, "location = /auth-request.php") !== false) {
	        $content = preg_replace(
	            '/#\s*\n#\s*ucwc-auth-fix:[\s\S]*?location\s*=\s*\/auth-request\.php\s*\{[\s\S]*?\}\s*\n?/m',
	            "",
	            $content,
	            1
	        );
	        if (strpos($content, "location = /auth-request.php") !== false) {
	            $content = preg_replace(
	                '/location\s*=\s*\/auth-request\.php\s*\{[\s\S]*?\}\s*\n?/m',
	                "",
	                $content,
	                1
	            );
	        }
	    }
	$new = $block . "\n" . ltrim((string)$content);
	    if (@file_put_contents($loc, $new) === false) return;
	    @chmod($loc, 0644);
	    // Prefer Unraid webGUI master pid file; avoid pgrep (many container nginx masters).
	    $pid = is_file("/var/run/nginx.pid") ? trim((string)@file_get_contents("/var/run/nginx.pid")) : "";
	    if ($pid === "" || !ctype_digit($pid)) return;
	    $n = (int)$pid;
	    $hupOk = false;
	    if (function_exists("posix_kill")) {
	        $hupOk = @posix_kill($n, defined("SIGHUP") ? (int)constant("SIGHUP") : 1);
	    }
	    if (!$hupOk && function_exists("shell_exec")) {
	        @shell_exec("kill -HUP " . $n . " >/dev/null 2>&1");
	        $hupOk = true;
	    }
	    @file_put_contents(
	        "/tmp/ucwc-nginx-auth-fix.log",
	        date("c") . " reinject+HUP pid={$n} ok=" . ($hupOk ? "1" : "0") . " via=ThemeEffects\n",
	        FILE_APPEND
	    );
	})();

	$f1 = "background-1.jpg";
$f2 = "background-2.jpg";
$fc = "background-custom.jpg";
$fd = "background-dynamic.jpg";

