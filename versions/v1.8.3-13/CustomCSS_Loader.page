<?php
require_once "$docroot/plugins/dynamix/include/Wrappers.php";

/* Wallpaper upload limits: plugin-scoped drop-in (not /boot/config/go).
	 * Idempotent + least privilege: only copy if missing or content differs. */
	(function () {
	    $src = '/boot/config/plugins/custom.css/ucwc-upload.ini';
	    $dst = '/etc/php.d/ucwc-upload.ini';
	    if (!is_file($src)) return;
	    $need = !is_file($dst);
	    if (!$need) {
	        $a = @file_get_contents($src);
	        $b = @file_get_contents($dst);
	        $need = ($a !== false && $a !== $b);
	    }
	    if ($need) {
	        @mkdir('/etc/php.d', 0755, true);
	        if (@copy($src, $dst)) @chmod($dst, 0644);
	    }
	})();

	/* Re-apply nginx auth-request CONTENT_LENGTH clear after rc.nginx rebuilds locations.conf.
	 * Large multipart uploads (custom mascot/wallpaper) otherwise hang on「应用中…」(504). */
	(function () {
	    $src = '/boot/config/plugins/custom.css/ucwc-auth-request.conf';
	    $loc = '/etc/nginx/conf.d/locations.conf';
	    $marker = 'ucwc-auth-fix';
	    $block =
	        "#\n" .
	        "# {$marker}: large multipart POST hangs because auth subrequest inherits CONTENT_LENGTH\n" .
	        "# and PHP-FPM waits for a body that never arrives → 504 → browser stuck on 应用中…\n" .
	        "#\n" .
	        "location = /auth-request.php {\n" .
	        "    internal;\n" .
	        "    include fastcgi_params;\n" .
	        "    fastcgi_param CONTENT_LENGTH \"\";\n" .
	        "    fastcgi_param REQUEST_METHOD GET;\n" .
	        "}\n";
	    if (!is_file($src) || strpos((string)@file_get_contents($src), 'fastcgi_param CONTENT_LENGTH') === false) {
	        @file_put_contents($src, $block);
	        @chmod($src, 0644);
	    }
	    if (!is_file($loc) || !is_writable($loc)) return;
	    $content = @file_get_contents($loc);
	    if ($content === false) return;
	    if (
	        strpos($content, $marker) !== false &&
	        strpos($content, 'location = /auth-request.php') !== false &&
	        strpos($content, 'fastcgi_param CONTENT_LENGTH') !== false
	    ) {
	        return;
	    }
	    if (strpos($content, 'location = /auth-request.php') !== false) {
	        $content = preg_replace(
	            '/#\s*\n#\s*ucwc-auth-fix:[\s\S]*?location\s*=\s*\/auth-request\.php\s*\{[\s\S]*?\}\s*\n?/m',
	            '',
	            $content,
	            1
	        );
	        if (strpos($content, 'location = /auth-request.php') !== false) {
	            $content = preg_replace(
	                '/location\s*=\s*\/auth-request\.php\s*\{[\s\S]*?\}\s*\n?/m',
	                '',
	                $content,
	                1
	            );
	        }
	    }
	if (@file_put_contents($loc, $block . "\n" . ltrim((string)$content)) === false) return;
	    @chmod($loc, 0644);
	    // Prefer Unraid webGUI master pid file; avoid pgrep (many container nginx masters).
	    $pid = is_file('/var/run/nginx.pid') ? trim((string)@file_get_contents('/var/run/nginx.pid')) : '';
	    if ($pid === '' || !ctype_digit($pid)) return;
	    $n = (int)$pid;
	    $hupOk = false;
	    if (function_exists('posix_kill')) {
	        $hupOk = @posix_kill($n, defined('SIGHUP') ? (int)constant('SIGHUP') : 1);
	    }
	    if (!$hupOk && function_exists('shell_exec')) {
	        @shell_exec('kill -HUP ' . $n . ' >/dev/null 2>&1');
	        $hupOk = true;
	    }
	    @file_put_contents(
	        '/tmp/ucwc-nginx-auth-fix.log',
	        date('c') . " reinject+HUP pid={$n} ok=" . ($hupOk ? '1' : '0') . " via=Loader\n",
	        FILE_APPEND
	    );
	})();

	$web_css = '/plugins/custom.css/style.css';
$local_css = '/usr/local/emhttp/plugins/custom.css/style.css';
$web_black_css = '/plugins/custom.css/style-black.css';
$local_black_css = '/usr/local/emhttp/plugins/custom.css/style-black.css';
$fx_path = '/boot/config/plugins/custom.css/theme-effects.cfg';
$unraid_theme_cfg = '/boot/config/plugins/dynamix/dynamix.cfg';
$rt = '/usr/local/emhttp/plugins/custom.css/assets';

$fx = [
    'PARTICLES' => 'no',
    'PARTICLES_COUNT' => '60',
    'HUTAO' => 'yes',
    'HUTAO_SIZE' => 'medium',
    'HUTAO_POS' => 'br',
    'HUTAO_TYPE' => 'hutao',
    'HUTAO_BLUR' => 'no',
    'REDUCE_MOTION' => 'no',
    'BG_MODE' => 'local',
    'BG_LOCAL_SLOT' => '1',
    'BG_GALLERY' => 'photo',
    'BG_CUSTOM_API' => '',
    'BG_BLUR' => 'no',
];
if (is_file($fx_path)) {
    $raw = @parse_ini_file($fx_path);
    if (is_array($raw)) {
        foreach ($fx as $k => $v) {
            if (isset($raw[$k]) && $raw[$k] !== '') $fx[$k] = (string)$raw[$k];
        }
    }
}
$fx_particles = ($fx['PARTICLES'] === 'yes');
$fx_hutao = ($fx['HUTAO'] !== 'no');
$fx_reduce = ($fx['REDUCE_MOTION'] === 'yes');
$fx_blur = (($fx['BG_BLUR'] ?? 'no') === 'yes');
$fx_mascot_blur = (($fx['HUTAO_BLUR'] ?? 'no') === 'yes');
$fx_count = intval($fx['PARTICLES_COUNT']);
if ($fx_count < 30) $fx_count = 30;
if ($fx_count > 120) $fx_count = 120;
$load_particles = $fx_particles && !$fx_reduce;
$fx_hutao_size = in_array($fx['HUTAO_SIZE'], ['small', 'medium', 'large'], true) ? $fx['HUTAO_SIZE'] : 'medium';
$fx_hutao_pos = in_array($fx['HUTAO_POS'], ['tl', 'tr', 'bl', 'br'], true) ? $fx['HUTAO_POS'] : 'br';
$fx_hutao_type = (($fx['HUTAO_TYPE'] ?? 'hutao') === 'custom') ? 'custom' : 'hutao';
// CSS var scale: small 0.78 / medium 1 / large 1.28
$hutao_scale = ($fx_hutao_size === 'small') ? '0.78' : (($fx_hutao_size === 'large') ? '1.28' : '1');
$mascot_url = '/plugins/custom.css/assets/hutao.gif';
if ($fx_hutao_type === 'custom') {
    $custom_gif = $rt . '/mascot-custom.gif';
    if (is_file($custom_gif) && filesize($custom_gif) > 0) {
        $mascot_url = '/plugins/custom.css/assets/mascot-custom.gif?v=' . filemtime($custom_gif);
    } else {
        // Fallback to built-in if custom missing
        $fx_hutao_type = 'hutao';
    }
}

// 壁纸仅本地 assets 根目录
$bg_url = '/plugins/custom.css/assets/background-1.jpg';
$bg_mode = ($fx['BG_MODE'] === 'dynamic') ? 'dynamic' : 'local';
$bg_slot = in_array($fx['BG_LOCAL_SLOT'], ['1', '2', 'custom'], true) ? $fx['BG_LOCAL_SLOT'] : '1';
$pick = '';
if ($bg_mode === 'dynamic') {
    $pick = $rt . '/background-dynamic.jpg';
} elseif ($bg_slot === '2') {
    $pick = $rt . '/background-2.jpg';
} elseif ($bg_slot === 'custom') {
    $pick = $rt . '/background-custom.jpg';
} else {
    $pick = $rt . '/background-1.jpg';
    if (!is_file($pick) || filesize($pick) <= 0) {
        $pick = $rt . '/background.jpg'; // 兼容旧文件名
    }
}
if ($pick !== '' && is_file($pick) && filesize($pick) > 0) {
    $web = str_replace('/usr/local/emhttp', '', $pick);
    $bg_url = $web . '?v=' . filemtime($pick);
}

// Status-bar / browser chrome color: sample top of wallpaper (not pure black)
$ucwc_status_color = '#222630';
if ($pick !== '' && is_file($pick) && function_exists('imagecreatefromjpeg')) {
    $ext = strtolower(pathinfo($pick, PATHINFO_EXTENSION));
    $im = null;
    if ($ext === 'jpg' || $ext === 'jpeg') $im = @imagecreatefromjpeg($pick);
    elseif ($ext === 'png' && function_exists('imagecreatefrompng')) $im = @imagecreatefrompng($pick);
    elseif ($ext === 'webp' && function_exists('imagecreatefromwebp')) $im = @imagecreatefromwebp($pick);
    if ($im) {
        $w = imagesx($im); $h = imagesy($im);
        $rs = $gs = $bs = $n = 0;
        $rows = max(1, min(48, (int)($h * 0.04)));
        $step = max(1, (int)($w / 100));
        for ($y = 0; $y < $rows; $y++) {
            for ($x = 0; $x < $w; $x += $step) {
                $rgb = imagecolorat($im, $x, $y);
                $rs += ($rgb >> 16) & 255;
                $gs += ($rgb >> 8) & 255;
                $bs += $rgb & 255;
                $n++;
            }
        }
        if ($n > 0) {
            $ucwc_status_color = sprintf('#%02x%02x%02x', (int)round($rs/$n), (int)round($gs/$n), (int)round($bs/$n));
        }
        imagedestroy($im);
    }
}

$settings = parse_plugin_cfg("custom.css");
if (($settings['SERVICE'] ?? "disabled") === "enabled") {
    if (file_exists($local_css)) {
        $ver = filemtime($local_css);
        ?>
        <link rel="stylesheet" type="text/css" href="<?=$web_css?>?v=<?=$ver?>">
        <?php
    }
    $current_theme = @parse_ini_file($unraid_theme_cfg)['theme'] ?? 'white';
    if ($current_theme === 'black' && file_exists($local_black_css)) {
        $ver_black = filemtime($local_black_css);
        ?>
        <link rel="stylesheet" type="text/css" href="<?=$web_black_css?>?v=<?=$ver_black?>">
        <?php
    }
}
?>
<!-- unraid-custom-webui-css:theme-effects:start -->
<meta name="theme-color" content="<?= htmlspecialchars($ucwc_status_color, ENT_QUOTES) ?>">
<meta name="msapplication-navbutton-color" content="<?= htmlspecialchars($ucwc_status_color, ENT_QUOTES) ?>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">
<style id="ucwc-bg-style">
:root {
  --ucwc-bg-url: url("<?= htmlspecialchars($bg_url, ENT_QUOTES) ?>");
  --ucwc-hutao-scale: <?= htmlspecialchars($hutao_scale, ENT_QUOTES) ?>;
  --ucwc-mascot-url: url("<?= htmlspecialchars($mascot_url, ENT_QUOTES) ?>");
  --ucwc-status-color: <?= htmlspecialchars($ucwc_status_color, ENT_QUOTES) ?>;
  --page-bg: <?= htmlspecialchars($ucwc_status_color, ENT_QUOTES) ?>;
}
</style>
<script>
window.__UCWC_THEME__ = {
  particles: <?= $fx_particles ? 'true' : 'false' ?>,
  particles_count: <?= (int)$fx_count ?>,
  hutao: <?= $fx_hutao ? 'true' : 'false' ?>,
  hutao_size: <?= json_encode($fx_hutao_size) ?>,
  hutao_pos: <?= json_encode($fx_hutao_pos) ?>,
  hutao_type: <?= json_encode($fx_hutao_type) ?>,
  hutao_blur: <?= $fx_mascot_blur ? 'true' : 'false' ?>,
  mascot_url: <?= json_encode($mascot_url) ?>,
  reduce_motion: <?= $fx_reduce ? 'true' : 'false' ?>,
  bg_mode: <?= json_encode($bg_mode) ?>,
  bg_url: <?= json_encode($bg_url) ?>,
  bg_blur: <?= $fx_blur ? 'true' : 'false' ?>
};
(function () {
  var t = window.__UCWC_THEME__ || {};
  var mascotEl = null;
  var mascotSrcLocked = '';
  var freezeEl = null;
  var thawTimer = null;
  var classesApplied = false;

  function setClass(el, name, on) {
    if (!el || !el.classList) return;
    var has = el.classList.contains(name);
    if (on && !has) el.classList.add(name);
    else if (!on && has) el.classList.remove(name);
  }

  function ensureMascot() {
    if (t.hutao === false) {
      mascotEl = document.getElementById('ucwc-mascot') || mascotEl;
      if (mascotEl) {
        setClass(mascotEl, 'ucwc-mascot-off', true);
        mascotEl.setAttribute('hidden', '');
      }
      if (freezeEl) freezeEl.style.display = 'none';
      return null;
    }
    mascotEl = document.getElementById('ucwc-mascot');
    if (!mascotEl) {
      mascotEl = document.createElement('img');
      mascotEl.id = 'ucwc-mascot';
      mascotEl.alt = '';
      mascotEl.setAttribute('aria-hidden', 'true');
      try { mascotEl.decoding = 'sync'; } catch (e0) {}
      mascotEl.draggable = false;
      try { mascotEl.loading = 'eager'; } catch (e1) {}
      // Hint browser to keep layer; avoid display toggles later
      mascotEl.style.contain = 'strict';
      if (document.body) document.body.appendChild(mascotEl);
      else if (document.documentElement) document.documentElement.appendChild(mascotEl);
    }
    setClass(mascotEl, 'ucwc-mascot-off', false);
    mascotEl.removeAttribute('hidden');
    var url = t.mascot_url || '/plugins/custom.css/assets/hutao.gif';
    // Only set src when URL actually changes — reassignment restarts GIF (flicker).
    if (url && mascotSrcLocked !== url) {
      mascotSrcLocked = url;
      if (mascotEl.getAttribute('src') !== url) mascotEl.src = url;
    }
    return mascotEl;
  }

  /** Snapshot current GIF frame onto a fixed canvas so tab hide/show restart is covered. */
  function freezeMascotFrame() {
    try {
      var img = ensureMascot();
      if (!img || !img.complete || !(img.naturalWidth > 0)) return;
      var r = img.getBoundingClientRect();
      if (!(r.width > 0 && r.height > 0)) return;
      freezeEl = document.getElementById('ucwc-mascot-freeze');
      if (!freezeEl) {
        freezeEl = document.createElement('canvas');
        freezeEl.id = 'ucwc-mascot-freeze';
        freezeEl.setAttribute('aria-hidden', 'true');
        freezeEl.style.cssText =
          'position:fixed;z-index:2;pointer-events:none;display:none;margin:0;padding:0;border:0;';
        (document.body || document.documentElement).appendChild(freezeEl);
      }
      var nw = img.naturalWidth;
      var nh = img.naturalHeight;
      if (freezeEl.width !== nw) freezeEl.width = nw;
      if (freezeEl.height !== nh) freezeEl.height = nh;
      var ctx = freezeEl.getContext('2d');
      if (!ctx) return;
      ctx.clearRect(0, 0, nw, nh);
      ctx.drawImage(img, 0, 0, nw, nh);
      freezeEl.style.left = r.left + 'px';
      freezeEl.style.top = r.top + 'px';
      freezeEl.style.width = r.width + 'px';
      freezeEl.style.height = r.height + 'px';
      freezeEl.style.right = 'auto';
      freezeEl.style.bottom = 'auto';
      freezeEl.style.opacity = '1';
      freezeEl.style.display = 'block';
      // Hide live GIF under freeze (class beats opacity !important)
      if (img.classList) img.classList.add('ucwc-mascot-frozen');
    } catch (e) {}
  }

  function thawMascotFrame() {
    try {
      if (thawTimer) {
        clearTimeout(thawTimer);
        thawTimer = null;
      }
      var img = document.getElementById('ucwc-mascot');
      freezeEl = document.getElementById('ucwc-mascot-freeze');
      // Two rAFs + short delay: let GIF decoder present a frame before revealing
      var reveal = function () {
        if (img && img.classList) img.classList.remove('ucwc-mascot-frozen');
        if (freezeEl) freezeEl.style.display = 'none';
      };
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          thawTimer = setTimeout(reveal, 48);
        });
      });
    } catch (e) {
      try {
        var img2 = document.getElementById('ucwc-mascot');
        if (img2 && img2.classList) img2.classList.remove('ucwc-mascot-frozen');
        if (freezeEl) freezeEl.style.display = 'none';
      } catch (e2) {}
    }
  }

  var apply = function (force) {
    var root = document.documentElement, body = document.body;
    var size = t.hutao_size || 'medium';
    var pos = t.hutao_pos || 'br';
    var posClass = ({ tl: 'ucwc-hutao-tl', tr: 'ucwc-hutao-tr', bl: 'ucwc-hutao-bl', br: 'ucwc-hutao-br' })[pos] || 'ucwc-hutao-br';
    var sizeClass = size === 'small' ? 'ucwc-hutao-sm' : (size === 'large' ? 'ucwc-hutao-lg' : 'ucwc-hutao-md');
    // Skip redundant class thrash after first paint (avoids GIF composite restart)
    if (classesApplied && !force) {
      ensureMascot();
      return;
    }
    if (root) {
      setClass(root, 'ucwc-hutao-off', t.hutao === false);
      setClass(root, 'ucwc-reduce-motion', !!t.reduce_motion);
      setClass(root, 'ucwc-particles-on', !!t.particles && !t.reduce_motion);
      setClass(root, 'ucwc-bg-blur', !!t.bg_blur);
      setClass(root, 'ucwc-no-bg-blur', !t.bg_blur);
      setClass(root, 'ucwc-mascot-blur', !!(t.hutao !== false && t.hutao_blur));
      ['ucwc-hutao-sm', 'ucwc-hutao-md', 'ucwc-hutao-lg', 'ucwc-hutao-tl', 'ucwc-hutao-tr', 'ucwc-hutao-bl', 'ucwc-hutao-br'].forEach(function (c) {
        setClass(root, c, false);
      });
      if (t.hutao !== false) {
        setClass(root, sizeClass, true);
        setClass(root, posClass, true);
      }
      if (t.mascot_url) {
        root.style.setProperty('--ucwc-mascot-url', 'url("' + String(t.mascot_url).replace(/"/g, '\\"') + '")');
      }
    }
    if (body) {
      setClass(body, 'ucwc-hutao-off', t.hutao === false);
      setClass(body, 'ucwc-reduce-motion', !!t.reduce_motion);
      setClass(body, 'ucwc-particles-on', !!t.particles && !t.reduce_motion);
      setClass(body, 'ucwc-bg-blur', !!t.bg_blur);
      setClass(body, 'ucwc-no-bg-blur', !t.bg_blur);
      setClass(body, 'ucwc-mascot-blur', !!(t.hutao !== false && t.hutao_blur));
    }
    ensureMascot();
    classesApplied = true;
  };
  if (document.body) apply(true); else document.addEventListener('DOMContentLoaded', function () { apply(true); });

  // Tab minimize/restore: browsers restart animated GIF from frame 0.
  // Cover with a canvas snapshot of the last frame so the jump is invisible.
  (function () {
    function onVis() {
      if (document.visibilityState === 'hidden') {
        freezeMascotFrame();
      } else {
        // Do NOT re-run full apply() (class thrash restarts GIF harder).
        ensureMascot();
        thawMascotFrame();
      }
    }
    document.addEventListener('visibilitychange', onVis, false);
    window.addEventListener('pagehide', function () {
      freezeMascotFrame();
    }, false);
    window.addEventListener('pageshow', function () {
      ensureMascot();
      thawMascotFrame();
    }, false);
    // blur/focus: some desktop browsers freeze GIF without visibilitychange
    window.addEventListener('blur', function () {
      if (document.visibilityState === 'hidden') freezeMascotFrame();
    }, false);
  })();

  // Fullscreen wallpaper: real DOM layer + mobile chrome theme-color
  (function () {
    var el = null;
    var root = document.documentElement;

    function ensureEl() {
      el = document.getElementById('ucwc-wallpaper');
      if (el) return el;
      el = document.createElement('div');
      el.id = 'ucwc-wallpaper';
      el.setAttribute('aria-hidden', 'true');
      if (document.body) document.body.insertBefore(el, document.body.firstChild);
      else if (root) root.appendChild(el);
      if (root) root.classList.add('ucwc-has-wallpaper');
      return el;
    }

    function cssPx(n) { return Math.ceil(n) + 'px'; }

    function ensureViewportFit() {
      try {
        var m = document.querySelector('meta[name="viewport"]');
        if (!m) {
          m = document.createElement('meta');
          m.setAttribute('name', 'viewport');
          m.setAttribute('content', 'width=device-width, initial-scale=1, viewport-fit=cover');
          (document.head || root).appendChild(m);
        } else {
          var c = m.getAttribute('content') || '';
          if (c.indexOf('viewport-fit') === -1) {
            m.setAttribute('content', c + (c ? ', ' : '') + 'viewport-fit=cover');
          }
        }
        var sc = getComputedStyle(root).getPropertyValue('--ucwc-status-color').trim() || '#222630';
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        if (!metas.length) {
          var tm = document.createElement('meta');
          tm.setAttribute('name', 'theme-color');
          tm.setAttribute('content', sc);
          (document.head || root).appendChild(tm);
        } else {
          for (var i = 0; i < metas.length; i++) metas[i].setAttribute('content', sc);
        }
        var ensureMeta = function (name, content) {
          var el = document.querySelector('meta[name="' + name + '"]');
          if (!el) {
            el = document.createElement('meta');
            el.setAttribute('name', name);
            (document.head || root).appendChild(el);
          }
          el.setAttribute('content', content);
        };
        ensureMeta('apple-mobile-web-app-status-bar-style', 'black-translucent');
        ensureMeta('apple-mobile-web-app-capable', 'yes');
        ensureMeta('mobile-web-app-capable', 'yes');
        root.style.backgroundColor = sc;
      } catch (e) {}
    }

    function isMobileLike() {
      try {
        var w = window.innerWidth || (root && root.clientWidth) || 0;
        var coarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
        var noHover = window.matchMedia && window.matchMedia('(hover: none)').matches;
        // 仅手机/窄屏走 overscan；桌面宽屏禁止用 screen.* 放大壁纸
        return w > 0 && w < 768 && (coarse || noHover || w <= 520);
      } catch (e) {
        return (window.innerWidth || 0) < 768;
      }
    }

    function fit() {
      try {
        ensureViewportFit();
        var node = ensureEl();
        if (!node) return;
        var vv = window.visualViewport;
        var mobile = isMobileLike();
        var w, h, left, top, layoutH;

        if (mobile) {
          // 移动端：覆盖状态栏/底部安全区，允许小幅 overscan
          var sw = Math.max(
            window.innerWidth || 0,
            (root && root.clientWidth) || 0,
            (vv && vv.width) || 0
          );
          var sh = Math.max(
            window.innerHeight || 0,
            (root && root.clientHeight) || 0,
            (vv && (vv.height + (vv.offsetTop || 0))) || 0
          );
          // 不用 screen.width/height：横竖屏与 CSS 像素不一致会导致放大
          var pad = Math.max(24, Math.min(64, Math.round(Math.max(sw, sh) * 0.06)));
          w = Math.max(sw, 1) + pad * 2;
          h = Math.max(sh, 1) + pad * 2;
          left = -pad - ((vv && vv.offsetLeft) || 0);
          top = -pad - ((vv && vv.offsetTop) || 0);
          layoutH = sh + pad;
        } else {
          // PC：贴合可视窗口，禁止 overscan，避免壁纸被放大裁切
          w = Math.max(
            window.innerWidth || 0,
            (root && root.clientWidth) || 0,
            (document.documentElement && document.documentElement.clientWidth) || 0,
            1
          );
          h = Math.max(
            window.innerHeight || 0,
            (root && root.clientHeight) || 0,
            (document.documentElement && document.documentElement.clientHeight) || 0,
            1
          );
          left = 0;
          top = 0;
          layoutH = h;
        }

        node.style.position = 'fixed';
        node.style.left = cssPx(left);
        node.style.top = cssPx(top);
        node.style.width = cssPx(w);
        node.style.height = cssPx(h);
        node.style.right = 'auto';
        node.style.bottom = 'auto';
        node.style.zIndex = '-2';
        node.style.pointerEvents = 'none';
        node.style.backgroundImage = 'var(--ucwc-bg-url)';
        node.style.backgroundSize = 'cover';
        node.style.backgroundPosition = 'center top';
        node.style.backgroundRepeat = 'no-repeat';
        if (root) {
          root.style.setProperty('--ucwc-cover-h', cssPx(h));
          root.style.minHeight = '';
          root.style.backgroundImage = 'var(--ucwc-bg-url)';
          root.style.backgroundSize = 'cover';
          root.style.backgroundPosition = 'center top';
          root.style.backgroundRepeat = 'no-repeat';
        }
        if (document.body) {
          document.body.style.minHeight = '';
          document.body.style.background = 'transparent';
          document.body.style.backgroundColor = 'transparent';
        }
      } catch (e) {}
    }

    function boot() {
      fit();
      setTimeout(fit, 50);
      setTimeout(fit, 300);
      setTimeout(fit, 1000);
    }

    if (document.body) boot();
    else document.addEventListener('DOMContentLoaded', boot);

    window.addEventListener('resize', fit, { passive: true });
    window.addEventListener('orientationchange', function () {
      setTimeout(fit, 50);
      setTimeout(fit, 300);
    }, { passive: true });
    document.addEventListener('fullscreenchange', fit, { passive: true });
    document.addEventListener('webkitfullscreenchange', fit, { passive: true });
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', fit, { passive: true });
      window.visualViewport.addEventListener('scroll', fit, { passive: true });
    }
    try {
      var mql = window.matchMedia && window.matchMedia('(display-mode: fullscreen), (display-mode: standalone), (display-mode: minimal-ui)');
      if (mql) {
        if (mql.addEventListener) mql.addEventListener('change', fit);
        else if (mql.addListener) mql.addListener(fit);
