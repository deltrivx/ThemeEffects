    if ($v === null) $v = "";
    if (function_exists("mb_substr")) $v = mb_substr($v, 0, 48, "UTF-8");
    else $v = substr($v, 0, 48);
    $v = trim($v);
    if ($v === "" || !preg_match('/^[\p{L}\p{N} ._\-]+$/u', $v)) return "";
