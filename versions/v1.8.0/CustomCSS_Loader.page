<?php
require_once "$docroot/plugins/dynamix/include/Wrappers.php";

$web_css = '/plugins/custom.css/style.css';
$local_css = '/usr/local/emhttp/plugins/custom.css/style.css';
$web_black_css = '/plugins/custom.css/style-black.css';
$local_black_css = '/usr/local/emhttp/plugins/custom.css/style-black.css';
$fx_path = '/boot/config/plugins/custom.css/theme-effects.cfg';
$unraid_theme_cfg = '/boot/config/plugins/dynamix/dynamix.cfg';
$rt = '/usr/local/emhttp/plugins/custom.css/assets';

$fx = [
    'PARTICLES' => 'no',
    'PARTICLES_COUNT' => '60',
    'HUTAO' => 'yes',
    'REDUCE_MOTION' => 'no',
    'BG_MODE' => 'local',
    'BG_LOCAL_SLOT' => '1',
    'BG_GALLERY' => 'photo',
    'BG_CUSTOM_API' => '',
];
if (is_file($fx_path)) {
    $raw = @parse_ini_file($fx_path);
    if (is_array($raw)) {
        foreach ($fx as $k => $v) {
            if (isset($raw[$k]) && $raw[$k] !== '') $fx[$k] = (string)$raw[$k];
        }
    }
}
$fx_particles = ($fx['PARTICLES'] === 'yes');
$fx_hutao = ($fx['HUTAO'] !== 'no');
$fx_reduce = ($fx['REDUCE_MOTION'] === 'yes');
$fx_count = intval($fx['PARTICLES_COUNT']);
if ($fx_count < 30) $fx_count = 30;
if ($fx_count > 120) $fx_count = 120;
$load_particles = $fx_particles && !$fx_reduce;

// 壁纸仅本地 assets 根目录
$bg_url = '/plugins/custom.css/assets/background-1.jpg';
$bg_mode = ($fx['BG_MODE'] === 'dynamic') ? 'dynamic' : 'local';
$bg_slot = in_array($fx['BG_LOCAL_SLOT'], ['1', '2', 'custom'], true) ? $fx['BG_LOCAL_SLOT'] : '1';
$pick = '';
if ($bg_mode === 'dynamic') {
    $pick = $rt . '/background-dynamic.jpg';
} elseif ($bg_slot === '2') {
    $pick = $rt . '/background-2.jpg';
} elseif ($bg_slot === 'custom') {
    $pick = $rt . '/background-custom.jpg';
} else {
    $pick = $rt . '/background-1.jpg';
    if (!is_file($pick) || filesize($pick) <= 0) {
        $pick = $rt . '/background.jpg'; // 兼容旧文件名
    }
}
if ($pick !== '' && is_file($pick) && filesize($pick) > 0) {
    $web = str_replace('/usr/local/emhttp', '', $pick);
    $bg_url = $web . '?v=' . filemtime($pick);
}

$settings = parse_plugin_cfg("custom.css");
if (($settings['SERVICE'] ?? "disabled") === "enabled") {
    if (file_exists($local_css)) {
        $ver = filemtime($local_css);
        ?>
        <link rel="stylesheet" type="text/css" href="<?=$web_css?>?v=<?=$ver?>">
        <?php
    }
    $current_theme = @parse_ini_file($unraid_theme_cfg)['theme'] ?? 'white';
    if ($current_theme === 'black' && file_exists($local_black_css)) {
        $ver_black = filemtime($local_black_css);
        ?>
        <link rel="stylesheet" type="text/css" href="<?=$web_black_css?>?v=<?=$ver_black?>">
        <?php
    }
}
?>
<!-- unraid-custom-webui-css:theme-effects:start -->
<style id="ucwc-bg-style">
:root { --ucwc-bg-url: url("<?= htmlspecialchars($bg_url, ENT_QUOTES) ?>"); }
</style>
<script>
window.__UCWC_THEME__ = {
  particles: <?= $fx_particles ? 'true' : 'false' ?>,
  particles_count: <?= (int)$fx_count ?>,
  hutao: <?= $fx_hutao ? 'true' : 'false' ?>,
  reduce_motion: <?= $fx_reduce ? 'true' : 'false' ?>,
  bg_mode: <?= json_encode($bg_mode) ?>,
  bg_url: <?= json_encode($bg_url) ?>
};
(function () {
  var t = window.__UCWC_THEME__ || {};
  var apply = function () {
    var root = document.documentElement, body = document.body;
    if (root) {
      root.classList.toggle('ucwc-hutao-off', t.hutao === false);
      root.classList.toggle('ucwc-reduce-motion', !!t.reduce_motion);
      root.classList.toggle('ucwc-particles-on', !!t.particles && !t.reduce_motion);
    }
    if (body) {
      body.classList.toggle('ucwc-hutao-off', t.hutao === false);
      body.classList.toggle('ucwc-reduce-motion', !!t.reduce_motion);
      body.classList.toggle('ucwc-particles-on', !!t.particles && !t.reduce_motion);
    }
  };
  if (document.body) apply(); else document.addEventListener('DOMContentLoaded', apply);
})();
</script>
<?php if ($load_particles && is_file('/usr/local/emhttp/plugins/custom.css/assets/ucwc-particles.js')):
  $pver = filemtime('/usr/local/emhttp/plugins/custom.css/assets/ucwc-particles.js');
?>
<script src="/plugins/custom.css/assets/ucwc-particles.js?v=<?=$pver?>"></script>
<?php endif; ?>
<!-- unraid-custom-webui-css:theme-effects:end -->
