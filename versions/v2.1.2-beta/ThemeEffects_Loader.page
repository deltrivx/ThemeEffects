    'yahei' => '"Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif',
];
$sanitize_family = function ($v) {
    $v = trim((string)$v);
    $v = str_replace(["\"", "'", ";", "{", "}", "<", ">", "\\"], "", $v);
    $v = preg_replace('/\s+/u', " ", $v);
    if ($v === null) $v = "";
    if (function_exists("mb_substr")) $v = mb_substr($v, 0, 48, "UTF-8");
    else $v = substr($v, 0, 48);
    $v = trim($v);
    if ($v === "" || !preg_match('/^[\p{L}\p{N} ._\-]+$/u', $v)) return "";
    return $v;
};
$local_name_ok = function ($v) {
    $v = strtolower(trim((string)$v));
