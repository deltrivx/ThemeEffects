    'ice'    => ['text' => '#e8f1ff', 'title' => '#ffffff', 'label' => '#5eb3ff', 'link' => '#5eb3ff', 'cyan' => '#7dd3fc', 'pink' => '#60a5fa', 'btn' => '#3b82f6', 'btn_hover' => '#2563eb', 'accent' => '94, 179, 255'],
    'gold'   => ['text' => '#f5efd8', 'title' => '#ffe9a8', 'label' => '#d4a017', 'link' => '#e0b53a', 'cyan' => '#f0d78c', 'pink' => '#d4a017', 'btn' => '#c9971a', 'btn_hover' => '#a67c12', 'accent' => '212, 160, 23'],
    'mint'   => ['text' => '#e8fff6', 'title' => '#ffffff', 'label' => '#3dd6c6', 'link' => '#3dd6c6', 'cyan' => '#5eead4', 'pink' => '#2dd4bf', 'btn' => '#14b8a6', 'btn_hover' => '#0d9488', 'accent' => '61, 214, 198'],
    'violet' => ['text' => '#f0e9ff', 'title' => '#ffffff', 'label' => '#a78bfa', 'link' => '#c4b5fd', 'cyan' => '#c4b5fd', 'pink' => '#a78bfa', 'btn' => '#8b5cf6', 'btn_hover' => '#7c3aed', 'accent' => '167, 139, 250'],
    'sunset' => ['text' => '#ffe8e0', 'title' => '#fff5f0', 'label' => '#fb923c', 'link' => '#fdba74', 'cyan' => '#fdba74', 'pink' => '#f97316', 'btn' => '#ea580c', 'btn_hover' => '#c2410c', 'accent' => '251, 146, 60'],
];
$preset_key = $fx['COLOR_PRESET'] ?? 'cyber';
if (!isset($color_presets[$preset_key]) && $preset_key !== 'custom') $preset_key = 'cyber';
