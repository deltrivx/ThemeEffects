}
$font_title_upper = (($fx['FONT_TITLE_UPPER'] ?? 'no') === 'yes') ? 'uppercase' : 'none';
$font_size = in_array((string)($fx['FONT_SIZE'] ?? '14'), ['13','14','15','16','17','18'], true) ? (string)$fx['FONT_SIZE'] : '14';
