<?php
require_once "$docroot/plugins/dynamix/include/Wrappers.php";

$web_css = '/plugins/custom.css/style.css';
$local_css = '/usr/local/emhttp/plugins/custom.css/style.css';
$web_black_css = '/plugins/custom.css/style-black.css';
$local_black_css = '/usr/local/emhttp/plugins/custom.css/style-black.css';
$fx_path = '/boot/config/plugins/custom.css/theme-effects.cfg';
$unraid_theme_cfg = '/boot/config/plugins/dynamix/dynamix.cfg';
$rt = '/usr/local/emhttp/plugins/custom.css/assets';

$fx = [
    'PARTICLES' => 'no',
    'PARTICLES_COUNT' => '60',
    'HUTAO' => 'yes',
    'HUTAO_SIZE' => 'medium',
    'HUTAO_POS' => 'br',
    'REDUCE_MOTION' => 'no',
    'BG_MODE' => 'local',
    'BG_LOCAL_SLOT' => '1',
    'BG_GALLERY' => 'photo',
    'BG_CUSTOM_API' => '',
];
if (is_file($fx_path)) {
    $raw = @parse_ini_file($fx_path);
    if (is_array($raw)) {
        foreach ($fx as $k => $v) {
            if (isset($raw[$k]) && $raw[$k] !== '') $fx[$k] = (string)$raw[$k];
        }
    }
}
$fx_particles = ($fx['PARTICLES'] === 'yes');
$fx_hutao = ($fx['HUTAO'] !== 'no');
$fx_reduce = ($fx['REDUCE_MOTION'] === 'yes');
$fx_count = intval($fx['PARTICLES_COUNT']);
if ($fx_count < 30) $fx_count = 30;
if ($fx_count > 120) $fx_count = 120;
$load_particles = $fx_particles && !$fx_reduce;
$fx_hutao_size = in_array($fx['HUTAO_SIZE'], ['small', 'medium', 'large'], true) ? $fx['HUTAO_SIZE'] : 'medium';
$fx_hutao_pos = in_array($fx['HUTAO_POS'], ['tl', 'tr', 'bl', 'br'], true) ? $fx['HUTAO_POS'] : 'br';
// CSS var scale: small 0.78 / medium 1 / large 1.28
$hutao_scale = ($fx_hutao_size === 'small') ? '0.78' : (($fx_hutao_size === 'large') ? '1.28' : '1');

// 壁纸仅本地 assets 根目录
$bg_url = '/plugins/custom.css/assets/background-1.jpg';
$bg_mode = ($fx['BG_MODE'] === 'dynamic') ? 'dynamic' : 'local';
$bg_slot = in_array($fx['BG_LOCAL_SLOT'], ['1', '2', 'custom'], true) ? $fx['BG_LOCAL_SLOT'] : '1';
$pick = '';
if ($bg_mode === 'dynamic') {
    $pick = $rt . '/background-dynamic.jpg';
} elseif ($bg_slot === '2') {
    $pick = $rt . '/background-2.jpg';
} elseif ($bg_slot === 'custom') {
    $pick = $rt . '/background-custom.jpg';
} else {
    $pick = $rt . '/background-1.jpg';
    if (!is_file($pick) || filesize($pick) <= 0) {
        $pick = $rt . '/background.jpg'; // 兼容旧文件名
    }
}
if ($pick !== '' && is_file($pick) && filesize($pick) > 0) {
    $web = str_replace('/usr/local/emhttp', '', $pick);
    $bg_url = $web . '?v=' . filemtime($pick);
}

$settings = parse_plugin_cfg("custom.css");
if (($settings['SERVICE'] ?? "disabled") === "enabled") {
    if (file_exists($local_css)) {
        $ver = filemtime($local_css);
        ?>
        <link rel="stylesheet" type="text/css" href="<?=$web_css?>?v=<?=$ver?>">
        <?php
    }
    $current_theme = @parse_ini_file($unraid_theme_cfg)['theme'] ?? 'white';
    if ($current_theme === 'black' && file_exists($local_black_css)) {
        $ver_black = filemtime($local_black_css);
        ?>
        <link rel="stylesheet" type="text/css" href="<?=$web_black_css?>?v=<?=$ver_black?>">
        <?php
    }
}
?>
<!-- unraid-custom-webui-css:theme-effects:start -->
<style id="ucwc-bg-style">
:root {
  --ucwc-bg-url: url("<?= htmlspecialchars($bg_url, ENT_QUOTES) ?>");
  --ucwc-hutao-scale: <?= htmlspecialchars($hutao_scale, ENT_QUOTES) ?>;
}
</style>
<script>
window.__UCWC_THEME__ = {
  particles: <?= $fx_particles ? 'true' : 'false' ?>,
  particles_count: <?= (int)$fx_count ?>,
  hutao: <?= $fx_hutao ? 'true' : 'false' ?>,
  hutao_size: <?= json_encode($fx_hutao_size) ?>,
  hutao_pos: <?= json_encode($fx_hutao_pos) ?>,
  reduce_motion: <?= $fx_reduce ? 'true' : 'false' ?>,
  bg_mode: <?= json_encode($bg_mode) ?>,
  bg_url: <?= json_encode($bg_url) ?>
};
(function () {
  var t = window.__UCWC_THEME__ || {};
  var apply = function () {
    var root = document.documentElement, body = document.body;
    var size = t.hutao_size || 'medium';
    var pos = t.hutao_pos || 'br';
    var posClass = ({ tl: 'ucwc-hutao-tl', tr: 'ucwc-hutao-tr', bl: 'ucwc-hutao-bl', br: 'ucwc-hutao-br' })[pos] || 'ucwc-hutao-br';
    if (root) {
      root.classList.toggle('ucwc-hutao-off', t.hutao === false);
      root.classList.toggle('ucwc-reduce-motion', !!t.reduce_motion);
      root.classList.toggle('ucwc-particles-on', !!t.particles && !t.reduce_motion);
      root.classList.remove('ucwc-hutao-sm', 'ucwc-hutao-md', 'ucwc-hutao-lg', 'ucwc-hutao-tl', 'ucwc-hutao-tr', 'ucwc-hutao-bl', 'ucwc-hutao-br');
      if (t.hutao !== false) {
        root.classList.add(size === 'small' ? 'ucwc-hutao-sm' : (size === 'large' ? 'ucwc-hutao-lg' : 'ucwc-hutao-md'));
        root.classList.add(posClass);
      }
    }
    if (body) {
      body.classList.toggle('ucwc-hutao-off', t.hutao === false);
      body.classList.toggle('ucwc-reduce-motion', !!t.reduce_motion);
      body.classList.toggle('ucwc-particles-on', !!t.particles && !t.reduce_motion);
    }
  };
  if (document.body) apply(); else document.addEventListener('DOMContentLoaded', apply);
  // Cover height: MAX(innerHeight, clientHeight, screen, visualViewport)
  // Fullscreen browsers need screen height; never shrink to visualViewport alone.
  (function () {
    var root = document.documentElement;
    if (!root) return;
    var setCover = function () {
      try {
        var vvObj = window.visualViewport;
        var vv = (vvObj && vvObj.height) || 0;
        var vTop = (vvObj && typeof vvObj.offsetTop === 'number') ? vvObj.offsetTop : 0;
        var ih = window.innerHeight || 0;
        var oh = window.outerHeight || 0;
        var ch = (root && root.clientHeight) || 0;
        var sh = (window.screen && (screen.height || screen.availHeight)) || 0;
        var av = (window.screen && screen.availHeight) || 0;
        // Fullscreen top black bar: layout viewport may start below status bar.
        var h = Math.max(ih, oh, ch, sh, av, vv + vTop, vv);
        var topGap = Math.max(0, vTop);
        if (sh > 0 && ih > 0 && sh > ih) {
          topGap = Math.max(topGap, Math.min(120, Math.round((sh - ih) * 0.25)));
        }
        var fs = false;
        try {
          fs = !!(document.fullscreenElement || document.webkitFullscreenElement);
          if (!fs && window.matchMedia) {
            fs = window.matchMedia('(display-mode: fullscreen), (display-mode: standalone), (display-mode: minimal-ui)').matches;
          }
        } catch (e2) {}
        if (fs && topGap < 24) topGap = 48;
        if (h > 0) root.style.setProperty('--ucwc-cover-h', Math.ceil(h) + 'px');
        root.style.setProperty('--ucwc-cover-top', Math.ceil(topGap) + 'px');
      } catch (e) {}
    };
    setCover();
    window.addEventListener('resize', setCover, { passive: true });
    window.addEventListener('orientationchange', function () {
      setTimeout(setCover, 50);
      setTimeout(setCover, 250);
    }, { passive: true });
    document.addEventListener('fullscreenchange', setCover, { passive: true });
    document.addEventListener('webkitfullscreenchange', setCover, { passive: true });
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', setCover, { passive: true });
      window.visualViewport.addEventListener('scroll', setCover, { passive: true });
    }
    try {
      var mql = window.matchMedia && window.matchMedia('(display-mode: fullscreen), (display-mode: standalone)');
      if (mql) {
        if (mql.addEventListener) mql.addEventListener('change', setCover);
        else if (mql.addListener) mql.addListener(setCover);
      }
    } catch (e) {}
  })();
})();
</script>
<?php if ($load_particles && is_file('/usr/local/emhttp/plugins/custom.css/assets/ucwc-particles.js')):
  $pver = filemtime('/usr/local/emhttp/plugins/custom.css/assets/ucwc-particles.js');
?>
<script src="/plugins/custom.css/assets/ucwc-particles.js?v=<?=$pver?>"></script>
<?php endif; ?>
<!-- unraid-custom-webui-css:theme-effects:end -->
<!-- unraid-custom-webui-css:apps-enhancement:start -->
<script src="/plugins/custom.css/assets/apps-enhancement.js?v=__VER__"></script>
<!-- unraid-custom-webui-css:apps-enhancement:end -->
