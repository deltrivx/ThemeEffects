---
<?php
/* unraid-custom-webui-css: 主题特效
 * 粒子 + 胡桃 + 背景 + 版本管理（检测更新 / 更新日志）。
 * CSRF：完全交给 Unraid BodyInlineJS 注入（与 CustomCSS.page 一致），本页不写 csrf 字段。
 */
$fx_path = "/boot/config/plugins/custom.css/theme-effects.cfg";
$assets_f = "/boot/config/plugins/custom.css/assets";
$assets_r = "/usr/local/emhttp/plugins/custom.css/assets";
$persist_dir = "/boot/config/plugins/custom.css";
$log_path = "/tmp/ucwc-theme-fx-save.log";
$upd_log = "/tmp/ucwc-theme-update.log";
$repo_raw = "https://raw.githubusercontent.com/deltrivx/unraid-custom-webui-css/main";
$msg = "";
$force_reload = false;

/* Free PHP session lock ASAP so nginx auth-request can run while this page works.
 * Unraid Translations starts+closes session; re-close if anything reopened it. */
if (function_exists("session_status") && session_status() === PHP_SESSION_ACTIVE) {
    @session_write_close();
}

/* Ensure wallpaper PHP upload limits without touching /boot/config/go */
(function () {
    $src = "/boot/config/plugins/custom.css/ucwc-upload.ini";
    $dst = "/etc/php.d/ucwc-upload.ini";
    if (!is_file($src)) {
        @file_put_contents($src, "; unraid-custom-webui-css: wallpaper upload limits\nupload_max_filesize = 12M\npost_max_size = 16M\nmax_file_uploads = 20\n");
        @chmod($src, 0644);
    }
    if (!is_file($src)) return;
    $need = !is_file($dst);
    if (!$need) {
        $a = @file_get_contents($src);
        $b = @file_get_contents($dst);
        $need = ($a !== false && $a !== $b);
    }
    if ($need) {
        @mkdir("/etc/php.d", 0755, true);
        if (@copy($src, $dst)) @chmod($dst, 0644);
    }
})();
$f1 = "background-1.jpg";
$f2 = "background-2.jpg";
$fc = "background-custom.jpg";
$fd = "background-dynamic.jpg";

function ucwc_fx_defaults() {
    return [
        "PARTICLES" => "no",
        "PARTICLES_COUNT" => "60",
        "HUTAO" => "yes",
        "HUTAO_SIZE" => "medium",
        "HUTAO_POS" => "br",
        "HUTAO_TYPE" => "hutao",
        "HUTAO_BLUR" => "no",
        "REDUCE_MOTION" => "no",
        "BG_MODE" => "local",
        "BG_LOCAL_SLOT" => "1",
        "BG_GALLERY" => "photo",
        "BG_CUSTOM_API" => "",
        "BG_BLUR" => "no",
    ];
}

function ucwc_fx_load($path) {
    $d = ucwc_fx_defaults();
    if (is_file($path)) {
        $raw = @parse_ini_file($path);
        if (is_array($raw)) {
            foreach ($d as $k => $v) {
                if (isset($raw[$k]) && $raw[$k] !== "") $d[$k] = (string)$raw[$k];
            }
        }
    }
    $d["PARTICLES"] = ($d["PARTICLES"] === "yes") ? "yes" : "no";
    $d["HUTAO"] = ($d["HUTAO"] === "no") ? "no" : "yes";
    if (!in_array($d["HUTAO_SIZE"], ["small", "medium", "large"], true)) $d["HUTAO_SIZE"] = "medium";
    if (!in_array($d["HUTAO_POS"], ["tl", "tr", "bl", "br"], true)) $d["HUTAO_POS"] = "br";
    $d["HUTAO_TYPE"] = ($d["HUTAO_TYPE"] === "custom") ? "custom" : "hutao";
    $d["HUTAO_BLUR"] = ($d["HUTAO_BLUR"] === "yes") ? "yes" : "no";
    $d["REDUCE_MOTION"] = ($d["REDUCE_MOTION"] === "yes") ? "yes" : "no";
    $n = intval($d["PARTICLES_COUNT"]);
    if ($n < 30) $n = 30;
    if ($n > 120) $n = 120;
    $d["PARTICLES_COUNT"] = (string)$n;
    $d["BG_MODE"] = ($d["BG_MODE"] === "dynamic") ? "dynamic" : "local";
    if (!in_array($d["BG_LOCAL_SLOT"], ["1", "2", "custom"], true)) $d["BG_LOCAL_SLOT"] = "1";
    if (!in_array($d["BG_GALLERY"], ["photo", "anime", "gufeng", "custom"], true)) $d["BG_GALLERY"] = "photo";
    $d["BG_CUSTOM_API"] = trim((string)$d["BG_CUSTOM_API"]);
    $d["BG_BLUR"] = ($d["BG_BLUR"] === "yes") ? "yes" : "no";
    return $d;
}

function ucwc_fx_save($path, $fx) {
    $keys = ["PARTICLES","PARTICLES_COUNT","HUTAO","HUTAO_SIZE","HUTAO_POS","HUTAO_TYPE","HUTAO_BLUR","REDUCE_MOTION","BG_MODE","BG_LOCAL_SLOT","BG_GALLERY","BG_CUSTOM_API","BG_BLUR"];
    $lines = [];
    foreach ($keys as $k) {
        $lines[] = $k . '="' . str_replace(['\\', '"'], ['\\\\', '\\"'], (string)$fx[$k]) . '"';
    }
    $lines[] = "";
    $ok = @file_put_contents($path, implode("\n", $lines)) !== false;
    if ($ok) @chmod($path, 0644);
    return $ok;
}

function ucwc_has($file) {
    return is_file($file) && @filesize($file) > 0;
}

function ucwc_chmod_pub($file) {
    if (is_file($file)) @chmod($file, 0644);
}

function ucwc_write_image($data, $dst_f, $dst_r) {
    if (@file_put_contents($dst_f, $data) === false) return false;
    @chmod($dst_f, 0644);
    @copy($dst_f, $dst_r);
    @chmod($dst_r, 0644);
    return true;
}

function ucwc_sync_pair($src, $dst_f, $dst_r) {
    if (!ucwc_has($src)) return false;
    if (!@copy($src, $dst_f)) return false;
    @chmod($dst_f, 0644);
    @copy($dst_f, $dst_r);
    @chmod($dst_r, 0644);
    return true;
}

function ucwc_is_image_bytes($data) {
    if ($data === false || $data === null || strlen($data) < 24 || strlen($data) > 15 * 1024 * 1024) return false;
    $h = substr($data, 0, 12);
    if (substr($h, 0, 3) === "\xFF\xD8\xFF") return true;
    if (substr($h, 0, 8) === "\x89PNG\r\n\x1a\n") return true;
    if (substr($h, 0, 6) === "GIF87a" || substr($h, 0, 6) === "GIF89a") return true;
    if (substr($h, 0, 4) === "RIFF" && substr($data, 8, 4) === "WEBP") return true;
    return false;
}

function ucwc_gallery_url($gallery, $custom) {
    if ($gallery === "anime") return "https://cdn.seovx.com/d/?mom=302";
    if ($gallery === "gufeng") return "https://cdn.seovx.com/ha/?mom=302";
    if ($gallery === "custom") return trim((string)$custom);
    return "https://cdn.seovx.com/?mom=302";
}

function ucwc_fetch_dynamic($url, $dst_f, $dst_r) {
    $url = trim($url);
    if ($url === "" || !preg_match('#^https?://#i', $url)) return "在线图库地址无效（需 http/https）。";
    if (!function_exists("curl_init")) return "服务器缺少 curl 扩展。";
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_MAXREDIRS => 5,
        CURLOPT_CONNECTTIMEOUT => 8,
        CURLOPT_TIMEOUT => 25,
        CURLOPT_SSL_VERIFYPEER => false,
        CURLOPT_SSL_VERIFYHOST => 0,
        CURLOPT_USERAGENT => "UCWC-ThemeEffects/1.0",
        CURLOPT_PROTOCOLS => CURLPROTO_HTTP | CURLPROTO_HTTPS,
        CURLOPT_REDIR_PROTOCOLS => CURLPROTO_HTTP | CURLPROTO_HTTPS,
    ]);
    $data = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_error($ch);
    curl_close($ch);
    if ($data === false || $data === "") return "拉取失败：" . ($err !== "" ? $err : "空响应");
    if ($code >= 400) return "拉取失败 HTTP " . $code;
    if (!ucwc_is_image_bytes($data)) return "返回内容不是有效图片。";
    if (!ucwc_write_image($data, $dst_f, $dst_r)) return "写入 background-dynamic.jpg 失败。";
    return "";
}

function ucwc_upload_err_msg($code) {
    $code = (int)$code;
    $uploadMax = ini_get("upload_max_filesize") ?: "?";
    $postMax = ini_get("post_max_size") ?: "?";
    switch ($code) {
        case UPLOAD_ERR_INI_SIZE:
            return "上传失败：文件超过 PHP upload_max_filesize（当前 {$uploadMax}）。请压缩壁纸后重试。";
        case UPLOAD_ERR_FORM_SIZE:
            return "上传失败：文件超过表单 MAX_FILE_SIZE 限制。";
        case UPLOAD_ERR_PARTIAL:
            return "上传失败：文件只上传了一部分，请重试。";
        case UPLOAD_ERR_NO_FILE:
            return "";
        case UPLOAD_ERR_NO_TMP_DIR:
            return "上传失败：服务器临时目录不可用。";
        case UPLOAD_ERR_CANT_WRITE:
            return "上传失败：无法写入临时文件。";
        case UPLOAD_ERR_EXTENSION:
            return "上传失败：被 PHP 扩展中断。";
        default:
            return "上传失败，错误码 {$code}（upload_max={$uploadMax}, post_max={$postMax}）。";
    }
}

function ucwc_handle_upload($file, $dst_f, $dst_r, $label = "background-custom.jpg", $gif_only = false) {
    // Empty POST + empty FILES often means post_max_size exceeded (PHP drops the body)
    if (!isset($file) || !is_array($file)) {
        $contentLen = isset($_SERVER["CONTENT_LENGTH"]) ? (int)$_SERVER["CONTENT_LENGTH"] : 0;
        $postMax = ini_get("post_max_size");
        if ($contentLen > 0 && empty($_POST) && empty($_FILES)) {
            return "上传失败：请求体被丢弃（可能超过 post_max_size={$postMax}）。请压缩文件后重试。";
        }
        return "";
    }
    $err = (int)($file["error"] ?? UPLOAD_ERR_NO_FILE);
    if ($err === UPLOAD_ERR_NO_FILE) return "";
    if ($err !== UPLOAD_ERR_OK) return ucwc_upload_err_msg($err);
    $tmp = $file["tmp_name"] ?? "";
    if ($tmp === "" || !is_uploaded_file($tmp)) return "上传临时文件无效。";
    $size = (int)($file["size"] ?? 0);
    if ($size <= 0) return "上传文件为空。";
    $uploadMax = ini_get("upload_max_filesize") ?: "2M";
    $maxBytes = $gif_only ? 8 * 1024 * 1024 : 15 * 1024 * 1024;
    if ($size > $maxBytes) {
        return $gif_only
            ? "自定义吉祥物不能超过 8MB（当前 PHP upload_max_filesize={$uploadMax}）。"
            : "自定义壁纸不能超过 15MB（当前 PHP upload_max_filesize={$uploadMax}）。";
    }
    $data = @file_get_contents($tmp);
    if ($data === false || $data === "") return "读取上传文件失败。";
    if ($gif_only) {
        $h = substr($data, 0, 6);
        if ($h !== "GIF87a" && $h !== "GIF89a") return "自定义吉祥物仅支持 GIF。";
    } elseif (!ucwc_is_image_bytes($data)) {
        return "仅支持 jpg / png / webp / gif。";
    }
    @mkdir(dirname($dst_f), 0755, true);
    @mkdir(dirname($dst_r), 0755, true);
    if (!ucwc_write_image($data, $dst_f, $dst_r)) {
        $perm = is_writable(dirname($dst_f)) ? "ok" : "no";
        return "保存 {$label} 失败（目录可写: {$perm}）。";
    }
    if (!ucwc_has($dst_f) && !ucwc_has($dst_r)) return "保存后未找到 {$label}。";
    return "";
}

function ucwc_log($path, $line) {
    @file_put_contents($path, date("c") . " " . $line . "\n", FILE_APPEND);
}

function ucwc_kv_file($path) {
    $out = [];
    if (!is_file($path)) return $out;
    $lines = @file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    if (!is_array($lines)) return $out;
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === "" || $line[0] === "#" || strpos($line, "=") === false) continue;
        [$k, $v] = explode("=", $line, 2);
        $out[trim($k)] = trim($v, " \t\"'");
    }
    return $out;
}

function ucwc_local_status($persist_dir) {
    $opts = ucwc_kv_file("$persist_dir/unraid-custom-webui-css.options");
    if (!$opts) $opts = ucwc_kv_file("$persist_dir/unraid-custom-webui-css.state");
    $installed = is_file("$persist_dir/style.css");
    $version = $opts["version"] ?? "";
    if ($version === "" && $installed) $version = "unknown";
    return [
        "installed" => $installed,
        "version" => $version,
        "updated_at" => $opts["updated_at"] ?? "",
        "particles" => $opts["particles"] ?? "",
        "hutao" => $opts["hutao"] ?? "",
        "theme_effects" => $opts["theme_effects"] ?? "",
        "source" => $opts["source"] ?? "",
    ];
}

function ucwc_http_get($url, $timeout = 12) {
    if (!function_exists("curl_init")) return [false, "服务器缺少 curl 扩展。", 0];
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_MAXREDIRS => 5,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_TIMEOUT => max(5, (int)$timeout),
        CURLOPT_SSL_VERIFYPEER => false,
        CURLOPT_SSL_VERIFYHOST => 0,
        CURLOPT_USERAGENT => "UCWC-ThemeEffects/1.8",
        CURLOPT_PROTOCOLS => CURLPROTO_HTTP | CURLPROTO_HTTPS,
        CURLOPT_REDIR_PROTOCOLS => CURLPROTO_HTTP | CURLPROTO_HTTPS,
    ]);
    $data = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_error($ch);
    curl_close($ch);
    if ($data === false || $data === "") return [false, $err !== "" ? $err : "空响应", $code];
    if ($code >= 400) return [false, "HTTP $code", $code];
    return [$data, "", $code];
}

function ucwc_fetch_index($repo_raw) {
    [$data, $err] = ucwc_http_get("$repo_raw/versions/index.json", 12);
    if ($data === false) return [null, "拉取版本索引失败：$err"];
    $json = json_decode($data, true);
    if (!is_array($json) || !isset($json["versions"]) || !is_array($json["versions"])) {
        return [null, "版本索引格式无效。"];
    }
    return [$json, ""];
}

function ucwc_fetch_changelog($repo_raw) {
    [$data, $err] = ucwc_http_get("$repo_raw/CHANGELOG.md", 12);
    if ($data === false) return ["", "拉取更新日志失败：$err"];
    return [$data, ""];
}

function ucwc_changelog_section($md, $version) {
    if ($md === "" || $version === "") return "";
    $ver = preg_quote($version, "/");
    if (!preg_match("/^##\\s+" . $ver . "\\b[^\\n]*\\n([\\s\\S]*?)(?=^##\\s+v|\\z)/m", $md, $m)) {
        return "";
    }
    return trim($m[0]);
}

function ucwc_normalize_version_flags($v) {
    return [
        "id" => (string)($v["id"] ?? ""),
        "label" => (string)($v["label"] ?? ""),
        "channel" => (string)($v["channel"] ?? "history"),
        "released_at" => (string)($v["released_at"] ?? ""),
        "apps_enhancement" => !empty($v["apps_enhancement"]),
        "particles" => !empty($v["particles"]),
        "hutao" => !empty($v["hutao"]),
        "theme_effects" => !empty($v["theme_effects"]),
    ];
}

function ucwc_valid_version_id($id) {
    return is_string($id) && preg_match('/^v[0-9]+\.[0-9]+(\.[0-9]+)?$/', $id);
}

function ucwc_run_install($repo_raw, $upd_log, $mode, $version = "") {
    @ini_set("max_execution_time", "300");
    @set_time_limit(300);
    if (!function_exists("curl_init")) return [false, "服务器缺少 curl 扩展。", ""];
    if ($mode === "install_version") {
        if (!ucwc_valid_version_id($version)) return [false, "版本号格式无效。", ""];
    } elseif ($mode !== "install_latest" && $mode !== "uninstall") {
        return [false, "未知安装动作。", ""];
    }

    // 写操作前再校验版本是否在索引中
    if ($mode === "install_version" || $mode === "install_latest") {
        [$index, $ierr] = ucwc_fetch_index($repo_raw);
        if ($index === null) return [false, $ierr, ""];
        $latest = (string)($index["latest_version"] ?? "");
        if ($mode === "install_latest") {
            $version = $latest;
            if (!ucwc_valid_version_id($version)) return [false, "远程 latest_version 无效。", ""];
        }
        $found = false;
        $has_fx = false;
        foreach ($index["versions"] as $v) {
            if (($v["id"] ?? "") === $version) {
                $found = true;
                $has_fx = !empty($v["theme_effects"]);
                break;
            }
        }
        if (!$found) return [false, "未知版本：$version", ""];
    } else {
        $has_fx = false;
        $version = "";
    }

    $script = "/tmp/ucwc-install-web.sh";
    [$body, $err] = ucwc_http_get("$repo_raw/scripts/install.sh", 60);
    if ($body === false) return [false, "下载 install.sh 失败：$err", ""];
    if (@file_put_contents($script, $body) === false) return [false, "写入临时脚本失败。", ""];
    @chmod($script, 0755);

    if ($mode === "uninstall") {
        $cmd = "sh " . escapeshellarg($script) . " uninstall 2>&1";
    } else {
        $cmd = "sh " . escapeshellarg($script) . " install " . escapeshellarg($version) . " 2>&1";
    }

    ucwc_log($upd_log, "run mode=$mode version=" . ($version !== "" ? $version : "-") . " cmd=$cmd");
    $output = [];
    $code = 1;
    @exec($cmd, $output, $code);
    $text = implode("\n", $output);
    ucwc_log($upd_log, "exit=$code\n$text");

    $ok = ($code === 0);
    $msg = $ok
        ? ($mode === "uninstall" ? "主题已卸载。" : "已安装 $version。")
        : ("操作失败（exit $code）。" . ($text !== "" ? " " . mb_substr($text, 0, 500) : ""));
    return [$ok, $msg, $text, $version, $has_fx ?? false];
}

function ucwc_json_out($payload, $http = 200) {
    if (!headers_sent()) {
        http_response_code($http);
        header("Content-Type: application/json; charset=utf-8");
        header("Cache-Control: no-store");
    }
    echo json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    exit;
}

// ---------- 版本管理 API（早退，不渲染页面）----------
$ucwc_action = "";
if (!empty($_POST["UCWC_ACTION"])) {
    $ucwc_action = (string)$_POST["UCWC_ACTION"];
} elseif (isset($_GET["ucwc_api"]) && (string)$_GET["ucwc_api"] === "1" && !empty($_GET["UCWC_ACTION"])) {
    $ucwc_action = (string)$_GET["UCWC_ACTION"];
}

if ($ucwc_action !== "") {
    $local = ucwc_local_status($persist_dir);
    if ($ucwc_action === "status" || $ucwc_action === "check_update") {
        [$index, $err] = ucwc_fetch_index($repo_raw);
        if ($index === null) {
            ucwc_json_out(["ok" => false, "error" => $err, "local" => $local], 502);
        }
        $latest = (string)($index["latest_version"] ?? "");
        $latest_meta = null;
        $versions = [];
        foreach ($index["versions"] as $v) {
            $nv = ucwc_normalize_version_flags($v);
            if ($nv["id"] === "") continue;
            $versions[] = $nv;
            if ($nv["id"] === $latest) $latest_meta = $nv;
        }
        $update_available = $local["installed"] && $local["version"] !== "" && $latest !== "" && $local["version"] !== $latest;
        ucwc_json_out([
            "ok" => true,
            "action" => $ucwc_action,
            "local" => $local,
            "latest_version" => $latest,
            "latest" => $latest_meta,
            "update_available" => $update_available,
            "versions" => $versions,
        ]);
    }

    if ($ucwc_action === "changelog" || $ucwc_action === "list_versions") {
        [$index, $err] = ucwc_fetch_index($repo_raw);
        if ($index === null) {
            ucwc_json_out(["ok" => false, "error" => $err, "local" => $local], 502);
        }
        [$md, $cerr] = ucwc_fetch_changelog($repo_raw);
        $versions = [];
        $want = isset($_POST["version"]) ? (string)$_POST["version"] : (isset($_GET["version"]) ? (string)$_GET["version"] : "");
        foreach ($index["versions"] as $v) {
            $nv = ucwc_normalize_version_flags($v);
            if ($nv["id"] === "") continue;
            $nv["changelog"] = ucwc_changelog_section($md, $nv["id"]);
            if ($nv["changelog"] === "" && $nv["label"] !== "") {
                $nv["changelog"] = $nv["label"];
            }
            $versions[] = $nv;
        }
        $selected = null;
        if ($want !== "" && ucwc_valid_version_id($want)) {
            foreach ($versions as $nv) {
                if ($nv["id"] === $want) { $selected = $nv; break; }
            }
        }
        if ($selected === null && $versions) $selected = $versions[0];
        ucwc_json_out([
            "ok" => true,
            "action" => $ucwc_action,
            "local" => $local,
            "latest_version" => (string)($index["latest_version"] ?? ""),
            "versions" => $versions,
            "selected" => $selected,
            "changelog_error" => $cerr,
        ]);
    }

    if ($ucwc_action === "install_latest" || $ucwc_action === "install_version" || $ucwc_action === "uninstall") {
        // 写操作仅接受 POST
        if (($_SERVER["REQUEST_METHOD"] ?? "") !== "POST") {
            ucwc_json_out(["ok" => false, "error" => "写操作需要 POST。"], 405);
        }
        $ver = isset($_POST["version"]) ? trim((string)$_POST["version"]) : "";
        $result = ucwc_run_install($repo_raw, $upd_log, $ucwc_action, $ver);
        $ok = $result[0];
        $message = $result[1];
        $output = $result[2] ?? "";
        $used_ver = $result[3] ?? $ver;
        $has_fx = $result[4] ?? false;
        $local2 = ucwc_local_status($persist_dir);
        ucwc_json_out([
            "ok" => $ok,
            "action" => $ucwc_action,
            "message" => $message,
            "output" => $output,
            "version" => $used_ver,
            "theme_effects" => $has_fx,
            "local" => $local2,
            "page_may_vanish" => ($ucwc_action === "uninstall") || ($ucwc_action === "install_version" && !$has_fx),
        ], $ok ? 200 : 500);
    }

    ucwc_json_out(["ok" => false, "error" => "未知动作：$ucwc_action"], 400);
}

@mkdir($assets_f, 0755, true);
@mkdir($assets_r, 0755, true);
foreach ([$f1, $f2, $fc, $fd, "background.jpg"] as $bn) {
    ucwc_chmod_pub("$assets_f/$bn");
    ucwc_chmod_pub("$assets_r/$bn");
}

if (!ucwc_has("$assets_f/$f1") && ucwc_has("$assets_f/background.jpg")) {
    ucwc_sync_pair("$assets_f/background.jpg", "$assets_f/$f1", "$assets_r/$f1");
}

// 仅「应用」提交才保存主题特效（避免版本管理 POST 误写 cfg）
if (!empty($_POST) && isset($_POST["SAVE_THEME_FX"])) {
    // Drop session lock before disk/network work so auth-request is not blocked
    if (function_exists("session_status") && session_status() === PHP_SESSION_ACTIVE) {
        @session_write_close();
    }
    $post_keys = implode(",", array_keys($_POST));
    $has_csrf = isset($_POST["csrf_token"]) ? "1" : "0";
    $csrf_len = isset($_POST["csrf_token"]) ? strlen((string)$_POST["csrf_token"]) : 0;
    $is_xhr = !empty($_SERVER["HTTP_X_REQUESTED_WITH"]);
    ucwc_log($log_path, "browser-post keys={$post_keys} csrf={$has_csrf} csrf_len={$csrf_len} xhr=" . ($is_xhr ? "1" : "0"));

    $fx = ucwc_fx_defaults();
    $fx["PARTICLES"] = (($_POST["PARTICLES"] ?? "no") === "yes") ? "yes" : "no";
    $fx["HUTAO"] = (($_POST["HUTAO"] ?? "yes") === "no") ? "no" : "yes";
    $hs = (string)($_POST["HUTAO_SIZE"] ?? "medium");
    $fx["HUTAO_SIZE"] = in_array($hs, ["small", "medium", "large"], true) ? $hs : "medium";
    $hp = (string)($_POST["HUTAO_POS"] ?? "br");
    $fx["HUTAO_POS"] = in_array($hp, ["tl", "tr", "bl", "br"], true) ? $hp : "br";
    $fx["HUTAO_TYPE"] = (((string)($_POST["HUTAO_TYPE"] ?? "hutao")) === "custom") ? "custom" : "hutao";
    $fx["HUTAO_BLUR"] = (($_POST["HUTAO_BLUR"] ?? "no") === "yes") ? "yes" : "no";
    $fx["REDUCE_MOTION"] = (($_POST["REDUCE_MOTION"] ?? "no") === "yes") ? "yes" : "no";
    // Prefer explicit commit field (JS mirrors range) then range itself
    $rawCount = $_POST["PARTICLES_COUNT_COMMIT"] ?? ($_POST["PARTICLES_COUNT"] ?? 60);
    $n = intval($rawCount);
    if ($n < 30) $n = 30;
    if ($n > 120) $n = 120;
    $fx["PARTICLES_COUNT"] = (string)$n;
    ucwc_log($log_path, "particles_count_raw=" . json_encode([
        "PARTICLES_COUNT" => $_POST["PARTICLES_COUNT"] ?? null,
        "PARTICLES_COUNT_COMMIT" => $_POST["PARTICLES_COUNT_COMMIT"] ?? null,
        "resolved" => $fx["PARTICLES_COUNT"],
    ], JSON_UNESCAPED_UNICODE));
    $fx["BG_MODE"] = (($_POST["BG_MODE"] ?? "local") === "dynamic") ? "dynamic" : "local";
    $slot = (string)($_POST["BG_LOCAL_SLOT"] ?? "1");
    $fx["BG_LOCAL_SLOT"] = in_array($slot, ["1", "2", "custom"], true) ? $slot : "1";
    $gal = (string)($_POST["BG_GALLERY"] ?? "photo");
    $fx["BG_GALLERY"] = in_array($gal, ["photo", "anime", "gufeng", "custom"], true) ? $gal : "photo";
    $fx["BG_CUSTOM_API"] = trim((string)($_POST["BG_CUSTOM_API"] ?? ""));
    $fx["BG_BLUR"] = (($_POST["BG_BLUR"] ?? "no") === "yes") ? "yes" : "no";

    $err = "";
    $fm = "mascot-custom.gif";
    if ($err === "" && $fx["HUTAO"] === "yes" && $fx["HUTAO_TYPE"] === "custom") {
        $err = ucwc_handle_upload($_FILES["HUTAO_UPLOAD"] ?? null, "$assets_f/$fm", "$assets_r/$fm", $fm, true);
        if ($err === "" && !ucwc_has("$assets_f/$fm") && !ucwc_has("$assets_r/$fm")) {
            $err = "请先选择并上传自定义吉祥物 GIF。";
        }
    }
    if ($fx["BG_MODE"] === "local" && $fx["BG_LOCAL_SLOT"] === "1") {
        if (!ucwc_has("$assets_f/$f1") && !ucwc_has("$assets_r/$f1")) {
            if (ucwc_has("$assets_f/background.jpg")) {
                ucwc_sync_pair("$assets_f/background.jpg", "$assets_f/$f1", "$assets_r/$f1");
            } elseif (ucwc_has("$assets_r/background.jpg")) {
                ucwc_sync_pair("$assets_r/background.jpg", "$assets_f/$f1", "$assets_r/$f1");
            }
        }
        if (!ucwc_has("$assets_f/$f1") && !ucwc_has("$assets_r/$f1")) {
            $err = "本地壁纸1 不存在（assets/background-1.jpg）。";
        } else {
            if (ucwc_has("$assets_f/$f1") && !ucwc_has("$assets_r/$f1")) @copy("$assets_f/$f1", "$assets_r/$f1");
            ucwc_chmod_pub("$assets_f/$f1");
            ucwc_chmod_pub("$assets_r/$f1");
        }
    }

    if ($err === "" && $fx["BG_MODE"] === "local" && $fx["BG_LOCAL_SLOT"] === "2") {
        if (!ucwc_has("$assets_f/$f2") && !ucwc_has("$assets_r/$f2")) {
            $err = "本地壁纸2 不存在（assets/background-2.jpg）。";
        } else {
            if (ucwc_has("$assets_f/$f2") && !ucwc_has("$assets_r/$f2")) @copy("$assets_f/$f2", "$assets_r/$f2");
            ucwc_chmod_pub("$assets_f/$f2");
            ucwc_chmod_pub("$assets_r/$f2");
        }
    }

    if ($err === "" && $fx["BG_MODE"] === "local" && $fx["BG_LOCAL_SLOT"] === "custom") {
        $uploadInfo = isset($_FILES["BG_UPLOAD"]) ? json_encode([
            "error" => $_FILES["BG_UPLOAD"]["error"] ?? null,
            "size" => $_FILES["BG_UPLOAD"]["size"] ?? null,
            "name" => $_FILES["BG_UPLOAD"]["name"] ?? null,
            "type" => $_FILES["BG_UPLOAD"]["type"] ?? null,
        ], JSON_UNESCAPED_UNICODE) : "null";
        ucwc_log($log_path, "upload_debug files=" . (empty($_FILES) ? "empty" : "set") . " post_keys=" . implode(",", array_keys($_POST)) . " BG_UPLOAD=" . $uploadInfo . " content_length=" . (int)($_SERVER["CONTENT_LENGTH"] ?? 0) . " upload_max=" . ini_get("upload_max_filesize") . " post_max=" . ini_get("post_max_size"));
        $err = ucwc_handle_upload($_FILES["BG_UPLOAD"] ?? null, "$assets_f/$fc", "$assets_r/$fc");
        if ($err === "" && !ucwc_has("$assets_f/$fc") && !ucwc_has("$assets_r/$fc")) {
            $err = "请先选择并上传自定义本地壁纸（建议 ≤2MB 的 jpg/png/webp）。";
        }
    }

    if ($err === "" && $fx["BG_MODE"] === "dynamic") {
        $url = ucwc_gallery_url($fx["BG_GALLERY"], $fx["BG_CUSTOM_API"]);
        $err = ucwc_fetch_dynamic($url, "$assets_f/$fd", "$assets_r/$fd");
    }

    $saved = ucwc_fx_save($fx_path, $fx);
    ucwc_log($log_path, "browser-saved saved=" . ($saved ? "1" : "0") . " err=" . ($err === "" ? "-" : $err) . " " . json_encode($fx, JSON_UNESCAPED_UNICODE));

    // Browser AJAX uses /plugins/custom.css/ucwc-theme-fx-save.php (clean JSON).
    // Full-page POST fallback still works here.
    if ($saved && $err === "") {
        $force_reload = true;
        $msg = "主题特效已保存，正在刷新页面…";
    } elseif (!$saved) {
        $msg = "写入 theme-effects.cfg 失败。";
    } else {
        $msg = $err . "（配置已记录，但资源未就绪）";
    }
} elseif (isset($_GET["applied"]) && $_GET["applied"] === "1") {
    $msg = "主题特效已应用并生效。";
} elseif (isset($_GET["updated"]) && $_GET["updated"] === "1") {
    $msg = "主题版本操作已完成，请强制刷新（Ctrl+F5）。";
}

$fx = ucwc_fx_load($fx_path);
$count = intval($fx["PARTICLES_COUNT"]);
$has_wp1 = ucwc_has("$assets_f/$f1") || ucwc_has("$assets_r/$f1") || ucwc_has("$assets_f/background.jpg");
$has_wp2 = ucwc_has("$assets_f/$f2") || ucwc_has("$assets_r/$f2");
$has_custom = ucwc_has("$assets_f/$fc") || ucwc_has("$assets_r/$fc");
$has_dyn = ucwc_has("$assets_f/$fd") || ucwc_has("$assets_r/$fd");
$ucwc_local = ucwc_local_status($persist_dir);
$ucwc_ver_label = $ucwc_local["installed"]
    ? (($ucwc_local["version"] !== "" && $ucwc_local["version"] !== "unknown") ? $ucwc_local["version"] : "已安装（版本未知）")
    : "未安装";
$ucwc_fx_js = "/usr/local/emhttp/plugins/custom.css/assets/ucwc-theme-fx.js";
$ucwc_fx_css = "/usr/local/emhttp/plugins/custom.css/assets/ucwc-theme-fx.css";
$ucwc_fx_js_v = is_file($ucwc_fx_js) ? filemtime($ucwc_fx_js) : time();
$ucwc_fx_css_v = is_file($ucwc_fx_css) ? filemtime($ucwc_fx_css) : time();
?>
<?if ($force_reload):?>
<script>
(function () {
  var u = "/Settings/ThemeEffects?applied=1&_ts=" + Date.now();
  try { window.location.replace(u); }
  catch (e) { window.location.href = u; }
})();
</script>
<?endif;?>
<link rel="stylesheet" href="/plugins/custom.css/assets/ucwc-theme-fx.css?v=<?=$ucwc_fx_css_v?>">
<script>
window.__UCWC_FX_BOOT__ = {
  version: <?= json_encode($ucwc_local["version"] ?? "", JSON_UNESCAPED_UNICODE) ?>,
  updated_at: <?= json_encode($ucwc_local["updated_at"] ?? "", JSON_UNESCAPED_UNICODE) ?>,
  installed: <?= !empty($ucwc_local["installed"]) ? "true" : "false" ?>
};
</script>
<script src="/plugins/custom.css/assets/ucwc-theme-fx.js?v=<?=$ucwc_fx_js_v?>"></script>

