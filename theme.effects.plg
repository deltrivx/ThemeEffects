<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "theme.effects">
<!ENTITY author    "deltrivx">
<!ENTITY version   "2026.07.29">
<!ENTITY launch    "Settings/ThemeEffects">
<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
<!ENTITY github    "deltrivx/ThemeEffects">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/theme.effects.plg">
<!ENTITY installSH "https://raw.githubusercontent.com/&github;/main/scripts/install.sh">
<!ENTITY ver       "v2.4.0">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" icon="magic" support="https://github.com/&github;">

<CHANGES>
## Theme Effects
###2026.07.29
- v2.4.0: third stable — dash close-tile/icons, perf profile rewrites effects, drop GPU_ACCEL
###2026.07.28
- v2.3.0: second stable — upload hints, Unraid fileTree, font preview, perf, first-run optimize
- v2.2.0: first stable 2.x — blur perf, blur levels, dual upload, SERVICE toggle
- v2.1.2-beta: font phase3 — custom family name + local woff2/ttf upload
- v2.1.1-beta / v2.1.0-beta: fonts, colors, title size
- v2.0.0-beta: standalone plugin theme.effects
</CHANGES>

<!-- Prepare dirs -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;/assets &plugdir;/assets
echo "Theme Effects: preparing &name;…"
exit 0
</INLINE>
</FILE>

<!-- README shown in plugin manager -->
<FILE Name="&plugdir;/README.md">
<INLINE>
<![CDATA[
**Theme Effects**

Standalone Unraid WebGUI theme (wallpaper, particles, mascot, Apps enhancements).
Does **not** require Custom WebUI CSS.

Settings: **Settings → User Preferences → 主题特效**

Repo: https://github.com/deltrivx/ThemeEffects
]]>
</INLINE>
</FILE>

<!-- Install / upgrade latest package via install.sh -->
<FILE Run="/bin/bash">
<INLINE>
set -e
export PATH="/usr/local/sbin:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin"
if ! command -v curl >/dev/null 2>&amp;1; then
  echo "curl required" &gt;&amp;2
  exit 1
fi
if ! command -v jq >/dev/null 2>&amp;1; then
  echo "jq required" &gt;&amp;2
  exit 1
fi
TMP=$(mktemp)
curl -4 -fsSL --connect-timeout 15 --max-time 120 --retry 2 -o "$TMP" "&installSH;"
chmod +x "$TMP"
# Non-interactive install of pinned version (install.sh also accepts install &lt;ver&gt;)
sh "$TMP" install "&ver;"
rm -f "$TMP"
# Ensure plugin manager sees our runtime pages (install.sh already copies)
echo "----------------------------------------------------"
echo " theme.effects &ver; installed."
echo " Open Settings → User Preferences → 主题特效"
echo "----------------------------------------------------"
exit 0
</INLINE>
</FILE>

<!-- Remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
set +e
export PATH="/usr/local/sbin:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin"
TMP=$(mktemp)
if curl -4 -fsSL --connect-timeout 10 --max-time 60 -o "$TMP" "&installSH;" 2>/dev/null; then
  chmod +x "$TMP"
  sh "$TMP" uninstall || true
fi
rm -f "$TMP"
rm -rf &plugdir;
# Keep &flash; user assets by default; uncomment to wipe:
# rm -rf &flash;
echo "theme.effects removed (flash config retained under &flash;)."
exit 0
</INLINE>
</FILE>

</PLUGIN>
