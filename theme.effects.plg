<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "theme.effects">
<!ENTITY author    "deltrivx">
<!ENTITY version   "2026.07.30c">
<!ENTITY launch    "Settings/ThemeEffects">
<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
<!ENTITY github    "deltrivx/ThemeEffects">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/theme.effects.plg">
<!ENTITY installSH "https://raw.githubusercontent.com/&github;/main/scripts/install.sh">
<!ENTITY ver       "v2.5.1">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" icon="magic" support="https://github.com/&github;">

<!-- CHANGES in CDATA: bare & in notes must not break simplexml_load_file -->
